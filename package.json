{
  "name": "react-editor-studio",
  "version": "1.0.9",
  "description": "Next-generation block-based rich text and interactive media editor for React, Next.js, and TypeScript. Features Notion-style blocks, live polls, election charts, live update timelines, responsive HTML export, and Tailwind CSS styling.",
  "type": "module",
  "main": "./dist/editor-studio.umd.cjs",
  "module": "./dist/editor-studio.js",
  "types": "./dist/types/index.d.ts",
  "homepage": "https://editor-studio-beige.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krunalsolanki123456/Editor_Studio.git"
  },
  "bugs": {
    "url": "https://github.com/krunalsolanki123456/Editor_Studio/issues"
  },
  "author": {
    "name": "Krunal Solanki",
    "url": "https://github.com/krunalsolanki123456"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "editor",
    "rich-text-editor",
    "block-editor",
    "notion-editor",
    "notion-clone",
    "gutenberg",
    "wysiwyg",
    "wysiwyg-editor",
    "react-editor",
    "nextjs-editor",
    "content-editor",
    "tiptap",
    "slate",
    "editorjs",
    "live-updates",
    "polls",
    "voting",
    "charts",
    "election-charts",
    "html-exporter",
    "tailwind-editor",
    "markdown-editor",
    "headless-editor",
    "cms-editor",
    "article-editor",
    "publishing",
    "react-component",
    "typescript",
    "interactive-editor",
    "media-editor",
    "drag-and-drop-editor"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/editor-studio.js",
      "require": "./dist/editor-studio.umd.cjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "nanoid": "^6.0.0",
    "react-range": "^1.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
